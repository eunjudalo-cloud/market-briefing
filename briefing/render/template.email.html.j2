{#- 데일리 마켓 브리핑 이메일 (인라인 CSS, table 레이아웃, 640px, 라이트/다크) -#}
{%- macro H2(title, sub='') -%}
<h2 class="text" style="font:600 15px/1.3 -apple-system,BlinkMacSystemFont,'Segoe UI','Malgun Gothic',sans-serif;color:#14171a;margin:0 0 8px;border-bottom:1px solid #e2e5ea;padding-bottom:5px;">{{ title }}{% if sub %} <span class="muted" style="font-weight:400;font-size:12px;color:#6b7280;">{{ sub }}</span>{% endif %}</h2>
{%- endmacro -%}
{%- set C_UP = '#c0392b' -%}{#- 상승=빨강(국내 관례) -#}
{%- set C_DOWN = '#1d6fb8' -%}{#- 하락=파랑 -#}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>데일리 마켓 브리핑 — {{ p.target_date.isoformat() }}</title>
<style>
  body{margin:0;padding:0;background:#f4f5f7;}
  img{border:0;line-height:100%;}
  a{color:#1a55c0;text-decoration:underline;}
  table{border-collapse:collapse;}
  .dt th,.dt td{border:1px solid #dfe2e7;padding:7px 10px;font-size:13px;text-align:right;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Malgun Gothic',sans-serif;}
  .dt th{background:#eef1f5;color:#1a1d21;font-weight:600;}
  .dt td:first-child,.dt th:first-child{text-align:left;}
  @media (max-width:480px){
    .wrap{width:100%!important;}
    .px{padding-left:16px!important;padding-right:16px!important;}
    .dt th,.dt td{font-size:12px;padding:6px 7px;}
  }
  @media (prefers-color-scheme:dark){
    body,.bg{background:#0f1115!important;}
    .wrap{background:#161922!important;}
    .text{color:#e7e9ec!important;}
    .muted{color:#9aa1ac!important;}
    .card{background:#1b1f29!important;border-color:#2b3140!important;}
    .summary{background:#12202f!important;border-color:#1f3d59!important;color:#dcebfb!important;}
    .dt th{background:#1f2430!important;color:#e7e9ec!important;border-color:#2b3140!important;}
    .dt td{border-color:#2b3140!important;color:#e7e9ec!important;}
    .rule{border-color:#2b3140!important;}
    h2{border-color:#2b3140!important;color:#e7e9ec!important;}
    a{color:#79a9ff!important;}
    .src{background:#242936!important;color:#aeb6c2!important;}
  }
</style>
</head>
<body class="bg">
<center>
<table role="presentation" class="wrap" width="640" cellpadding="0" cellspacing="0" style="width:640px;max-width:640px;background:#ffffff;">
  <tr><td class="px" style="padding:24px 32px 8px;">
    <div class="text" style="font:700 20px/1.3 -apple-system,BlinkMacSystemFont,'Segoe UI','Malgun Gothic',sans-serif;color:#14171a;">데일리 마켓 브리핑</div>
    <div class="muted" style="font:400 13px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','Malgun Gothic',sans-serif;color:#6b7280;">{{ p.target_date.isoformat() }} · 오전 7시 기준</div>
  </td></tr>

  <tr><td class="px" style="padding:12px 32px 4px;">
    <div class="summary text" style="font:400 14px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI','Malgun Gothic',sans-serif;color:#14324a;background:#eef5fb;border:1px solid #cfe3f3;border-radius:8px;padding:12px 14px;">
      {{ o.market_summary }}
      {% if o.fallback_used %}<br><span class="muted" style="font-size:12px;color:#6b7280;">※ AI 요약 미실행/실패 — 수치 기반 대체본</span>{% endif %}
    </div>
  </td></tr>

  {% if show_krx %}
  <tr><td class="px" style="padding:18px 32px 4px;">
    {{ H2('지수', '(전일 종가)') }}
    <table role="presentation" class="dt" width="100%" style="width:100%;">
      <thead><tr>
        <th scope="col">지수</th><th scope="col">종가</th><th scope="col">전일대비</th><th scope="col">등락률</th>
      </tr></thead>
      <tbody>
      {% for q in [p.kospi, p.kosdaq] %}
        {% if q and q.close is not none %}
        {% set up = (q.change_pct or 0) >= 0 %}
        {% set col = C_UP if up else C_DOWN %}
        <tr>
          <td>{{ q.name }}</td>
          <td>{{ q.close|num }}</td>
          <td style="color:{{ col }};">{{ q.change|signed }}</td>
          <td style="color:{{ col }};">{{ q.change_pct|signed }}%</td>
        </tr>
        {% else %}
        <tr><td>{{ q.name if q else '-' }}</td><td colspan="3" class="muted" style="text-align:left;color:#9aa1ac;">데이터 없음</td></tr>
        {% endif %}
      {% endfor %}
      </tbody>
    </table>
  </td></tr>

  <tr><td class="px" style="padding:18px 32px 4px;">
    {{ H2('투자자별 순매수 상위 10', '(전일)') }}
    {% for inv in investors %}
      <div class="text" style="font-weight:600;font-size:13px;margin:12px 0 2px;color:#14171a;">{{ inv.value }}</div>
      {% for mk in markets %}
        {% set rows = p.flows.top(inv, mk) %}
        <div class="muted" style="font-size:12px;margin:6px 0 2px;color:#6b7280;">{{ mk.value }}</div>
        {% if rows %}
        <table role="presentation" class="dt" width="100%" style="width:100%;">
          <tbody>
          {% for it in rows %}
            {% set col = C_UP if it.net_buy_krw_eok >= 0 else C_DOWN %}
            <tr>
              <td class="muted" style="width:26px;text-align:right;color:#9aa1ac;">{{ loop.index }}</td>
              <td>{{ it.name }} <span class="muted" style="color:#9aa1ac;">{{ it.code }}</span></td>
              <td style="color:{{ col }};">{{ it.net_buy_krw_eok|signed(1) }}억</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        {% else %}
        <div class="muted" style="font-size:12px;color:#9aa1ac;">데이터 없음</div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </td></tr>
  {% endif %}

  <tr><td class="px" style="padding:18px 32px 4px;">
    {{ H2('오늘 눈여겨볼 종목 3') }}
    {% if o.picks %}
      {% for pick in o.picks %}
      {% set is_d = pick.basis_type.value == 'disclosure' %}
      <div class="card" style="border:1px solid #e2e5ea;border-radius:8px;padding:12px 14px;margin:8px 0;background:#fafbfc;">
        <div class="text" style="font-weight:600;font-size:14px;color:#14171a;">{{ pick.name }} <span class="muted" style="font-weight:400;color:#9aa1ac;">{{ pick.code }}</span></div>
        <div style="margin-top:6px;">
          <span style="display:inline-block;font-size:11px;font-weight:600;padding:2px 6px;border-radius:4px;background:{{ '#e3ecff' if is_d else '#e0f2e6' }};color:{{ '#2b4a9b' if is_d else '#276a3c' }};">{{ '공시' if is_d else '수급' }}</span>
          <span class="text" style="font-size:13px;line-height:1.6;color:#2b2f34;"> {{ pick.basis_text }}</span>
        </div>
        {% if pick.source_url %}
        <div style="margin-top:5px;"><a href="{{ pick.source_url }}" style="font-size:12px;">공시 원문 →</a></div>
        {% endif %}
      </div>
      {% endfor %}
    {% else %}
      <div class="muted" style="font-size:13px;color:#9aa1ac;">공시·수급 근거를 갖춘 종목이 확인되지 않았습니다.</div>
    {% endif %}
  </td></tr>

  <tr><td class="px" style="padding:18px 32px 4px;">
    {{ H2('뉴스 헤드라인', '(제목·링크)') }}
    {% if p.news %}
    <table role="presentation" width="100%" style="width:100%;">
      {% for n in p.news %}
      <tr><td class="rule" style="padding:6px 0;border-bottom:1px solid #eef0f2;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Malgun Gothic',sans-serif;">
        <a href="{{ n.url }}" style="font-size:13px;line-height:1.5;">{{ n.title }}</a>
        <span class="src" style="display:inline-block;font-size:11px;color:#7a828c;background:#f0f2f4;border-radius:3px;padding:1px 5px;margin-left:4px;">{{ n.source }}</span>
      </td></tr>
      {% endfor %}
    </table>
    {% else %}
    <div class="muted" style="color:#9aa1ac;">수집된 헤드라인이 없습니다.</div>
    {% endif %}
  </td></tr>

  <tr><td class="px" style="padding:20px 32px 28px;">
    <hr class="rule" style="border:none;border-top:1px solid #e2e5ea;margin:0 0 12px;">
    <div class="muted" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Malgun Gothic',sans-serif;font-size:11px;line-height:1.6;color:#8a9099;">
      본 자료는 정보 제공 목적이며 투자 자문이나 매매 추천이 아닙니다.<br>
      출처: {% if show_krx %}KRX, {% endif %}OPENDART, 각 매체 RSS · 수집 창 {{ p.window_start.strftime('%Y-%m-%d %H:%M') }} ~ {{ p.window_end.strftime('%H:%M') }} KST · 생성 {{ o.generated_at.strftime('%Y-%m-%d %H:%M') }} KST
    </div>
  </td></tr>
</table>
</center>
</body>
</html>
