# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋 금지(.gitignore 포함).

# --- OpenAI (분석/요약 생성) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- OPENDART (공시 수집) ---
OPENDART_API_KEY=

# --- 공공데이터포털 (선택, KRX 실패 시 지수 대체 경로) ---
DATA_GO_KR_KEY=

# --- 이메일(SMTP) 발송 ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# --- 기타 ---
BRIEFING_TZ=Asia/Seoul
NEWS_MAX_ITEMS=15
# KRX(지수·투자자별 순매수) 수집/표시. 기본 off. 사용하려면 1
INCLUDE_KRX=0
